# Stage B (herbenzo_pipeline) — copy to .env if you use optional NCBI keys.
# Modernizer is deterministic (no LLM keys). Port contract: 8003
#
# Never commit real secrets.

# Optional — NCBI E-utilities (PubMed, Taxonomy, Gene, Protein).
# Keyless clients are limited to 3 requests/second. A key raises that to 10.
# Real environment variables override this file. Never commit a filled-in .env.
# NCBI_EMAIL=research@herbenzo.example
# NCBI_API_KEY=
# NCBI_TOOL=herbenzo-pipeline

# Optional — enrichment justification only. Stage B modernize never calls this.
# If HERBENZO_LLM_API_KEY is empty, the justification step is marked unavailable.
# OpenAI-compatible chat completions. The model must not supply physicochemical numbers.
# HERBENZO_LLM_API_KEY=
# HERBENZO_LLM_BASE_URL=https://api.openai.com/v1
# HERBENZO_LLM_MODEL=gpt-4o-mini

# Optional — where pending candidates and approved HB-* overlay rows are stored.
# HERBENZO_REGISTRY_DIR=
# HERBENZO_ENRICHMENT_CACHE_DIR=cache/enrichment

# Local IMPPAT 3.0 TSVs. Used after NCBI Taxonomy when this directory exists.
# CC BY-NC-ND 4.0. Do not commit the files. Leave unset to use data/external/imppat/cache/.
# Set to off to skip the lookup even when that directory exists.
# HERBENZO_IMPPAT_DIR=data/external/imppat/cache

# Ayush Research Portal (arp.ayush.gov.in). Opt-in bibliographic lookup.
# Off by default. One request every MIN_INTERVAL_S, no disk cache, no PDFs, no abstracts.
# LICENSE_BASIS / PERMISSION_REF record the 2026-10-06 verbal authorization
# (CCRAS Deputy Director Srikanth, Delhi). See data/external/ayush_portal/LICENSE_NOTICE.md.
# HERBENZO_AYUSH_PORTAL_ENABLED=false
# HERBENZO_AYUSH_PORTAL_BASE_URL=https://arp.ayush.gov.in
# HERBENZO_AYUSH_PORTAL_MIN_INTERVAL_S=2.0
# HERBENZO_AYUSH_PORTAL_TIMEOUT_S=15
# HERBENZO_AYUSH_PORTAL_MAX_RESULTS=10
# HERBENZO_AYUSH_PORTAL_USER_AGENT=herbenzo-pipeline/1.0 (Ayush Research Portal bibliographic lookup; research use)
# HERBENZO_AYUSH_PORTAL_LICENSE_BASIS=verbal_authorization
# HERBENZO_AYUSH_PORTAL_PERMISSION_REF=CCRAS Deputy Director Srikanth, Delhi, 2026-10-06; research use permitted for Herbenzo Ayurvedic and Herbal Pvt Ltd

# Optional — shared PubMed/PMID disk cache (Task T16):
# HERBENZO_PUBMED_CACHE_DIR=/Users/shivasaimomula/Desktop/herbenzo_shared_cache/pubmed
# HERBENZO_PUBMED_CACHE_TTL_S=2592000

# Optional — uvicorn bind (CLI default remains --port 8003):
# PORT=8003

# Not used by B (documented for federation consistency only):
# NVIDIA_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# PIPELINE_MODE=
