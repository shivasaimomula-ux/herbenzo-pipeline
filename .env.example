# Stage B (herbenzo_pipeline) — copy to .env if you use optional NCBI or LLM keys.
# /modernize is deterministic and does not call an LLM. Port contract: 8003
#
# Never commit real secrets. Process environment variables override this file.

# Optional — NCBI E-utilities (PubMed, Taxonomy, Gene, Protein, pccompound).
# Keyless clients are limited to 3 requests/second. A key raises that to 10.
# NCBI_EMAIL=research@herbenzo.example
# NCBI_API_KEY=
# NCBI_TOOL=herbenzo-pipeline

# Optional — research front door only. Modernize never reads these.
# Leave HERBENZO_LLM_API_KEY empty to stay on the deterministic NCBI/PubChem path.
#
# Gemini's OpenAI-compatible base is the URL below. A host with no path
# (https://generativelanguage.googleapis.com) returns 404.
# gemini-4.0-argon is not a published model. gemini-2.5-flash is.
# HERBENZO_LLM_API_KEY=
# HERBENZO_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# HERBENZO_LLM_MODEL=gemini-2.5-flash

# How many stored PubMed articles (pmid + title) an approval needs. Default 1.
# HERBENZO_MIN_PUBMED_REFS=1

# Gemini tool-call loop. Defaults: 8 steps, 60 seconds.
# HERBENZO_RESEARCH_MAX_STEPS=8
# HERBENZO_RESEARCH_TIMEOUT_S=60

# Optional web search for the research front door. Unset means status unavailable.
# web_fetch only opens URLs that web_search returned in the same session.
# HERBENZO_WEB_SEARCH_ENDPOINT=

# Local IMPPAT 3.0 TSVs. Advisory only, after NCBI Taxonomy, when this directory exists.
# CC BY-NC-ND 4.0. Do not commit the files. Leave unset to use data/external/imppat/cache/.
# Set to off to skip the lookup even when that directory exists.
# HERBENZO_IMPPAT_DIR=data/external/imppat/cache

# Optional — shared PubMed/PMID disk cache used by adjudication, not by live research:
# HERBENZO_PUBMED_CACHE_DIR=/Users/shivasaimomula/Desktop/herbenzo_shared_cache/pubmed
# HERBENZO_PUBMED_CACHE_TTL_S=2592000

# Optional — uvicorn bind (CLI default remains --port 8003):
# PORT=8003

# Not used by B (documented for federation consistency only):
# NVIDIA_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# PIPELINE_MODE=
